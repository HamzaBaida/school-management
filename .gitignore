```gitignore
# Laravel
/vendor
/node_modules
/public/hot
/public/storage
/storage/*.key
/storage/app/public
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*

# Environment files
.env
.env.backup
.env.production
.phpunit.result.cache

# Composer
composer.phar

# NPM
npm-debug.log
yarn-error.log

```
